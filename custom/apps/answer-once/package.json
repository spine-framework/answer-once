{
  "name": "@spine-framework/answer-once",
  "version": "0.2.7",
  "private": false,
  "description": "Answer Once \u2014 focused customer-support and knowledge-loop app for Spine Framework",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spine-framework/answer-once",
    "directory": "custom/apps/answer-once"
  },
  "bin": {
    "answer-once": "installer/index.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "spine-framework": ">=0.4.0 <0.6.0"
  },
  "dependencies": {},
  "files": [
    "index.tsx",
    "manifest.json",
    "standalone.config.json",
    "seed/",
    "pages/",
    "components/",
    "hooks/",
    "utils/",
    "functions/",
    "public/",
    "docs/",
    "agent/",
    "installer/",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "validate": "npx spine-framework validate-app .",
    "prepack": "node ../../npm/scripts/prepack-app.mjs stage",
    "postpack": "node ../../npm/scripts/prepack-app.mjs clean"
  },
  "spine": {
    "type": "app",
    "slug": "answer-once",
    "manifestPath": "manifest.json"
  }
}
