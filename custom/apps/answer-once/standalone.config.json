{
  "app_slug": "answer-once",
  "app_name": "Answer Once",
  "copy": {
    "framework_dirs": [
      ".framework/cli",
      ".framework/functions",
      ".framework/migrations",
      ".framework/public",
      ".framework/schemas",
      ".framework/scripts",
      ".framework/seeds",
      ".framework/src",
      ".framework/tests",
      ".framework/docs",
      ".framework/mcp",
      ".framework/templates"
    ],
    "framework_files": [
      ".framework/index.html",
      ".framework/README.md"
    ],
    "app_dirs": [
      "custom/apps/answer-once"
    ],
    "custom_migrations": [
      "062",
      "063",
      "064",
      "065",
      "066",
      "067",
      "068",
      "069",
      "070"
    ],
    "custom_tests": [
      "custom/tests/answer-once-export.test.ts",
      "custom/tests/answer-once-seeds.test.ts",
      "custom/tests/answer-once-journey.test.ts",
      "custom/tests/answer-once-security.test.ts",
      "custom/tests/answer-once-ui.test.ts"
    ],
    "config_files": [
      "config/vite.config.ts",
      "config/tsconfig.json",
      "config/tsconfig.node.json",
      "config/tsconfig.cli.json",
      "config/tsconfig.functions.json",
      "config/tailwind.config.cjs",
      "config/postcss.config.cjs",
      "config/components.json",
      "vitest.config.ts",
      ".env.example",
      ".gitignore"
    ],
    "root_scripts": [
      "scripts/assemble.sh",
      "scripts/assemble-frontend.sh",
      "scripts/assemble-functions.sh",
      "scripts/dev-netlify.sh",
      "scripts/dev-clean.sh",
      "scripts/netlify-dev-wrapper.sh",
      "scripts/verify-integrity.sh",
      "scripts/build-manifest.sh",
      "scripts/checksum-manifest.mts",
      "scripts/verify-manifest.mts",
      "scripts/boundary-check.sh",
      "scripts/verify-install.ts",
      "scripts/export-standalone.ts"
    ],
    "bin": [
      "bin/spine-framework.cjs",
      "bin/spine-framework.js"
    ],
    "file_map": {
      "README.md": "custom/apps/answer-once/docs/standalone-readme.md",
      "LICENSE.md": "custom/apps/answer-once/LICENSE.md"
    }
  },
  "exclude_globs": [
    "**/.env*",
    "**/.xenv*",
    "**/node_modules/**",
    "**/.DS_Store",
    "**/dist/**",
    "**/.assembled/**",
    "**/*.tsbuildinfo",
    "**/migrations/archive/**",
    ".framework/functions/_quarantine/**",
    ".framework/tests/integration/**",
    ".framework/public/spine.config.json",
    "custom/apps/answer-once/installer/**",
    "custom/apps/answer-once/LICENSE.md",
    "**/*.tgz"
  ],
  "netlify": {
    "scheduled_functions": [
      {
        "name": "custom_answeronce-autoresolve-cron",
        "schedule": "0 0 * * *"
      }
    ]
  },
  "install": {
    "symlinks": [
      {
        "path": "custom/apps/answer-once/functions/_shared",
        "target": "../../../../.framework/functions/_shared"
      },
      {
        "path": "custom/apps/answer-once/functions/admin-data.ts",
        "target": "../../../../.framework/functions/admin-data.ts"
      }
    ]
  },
  "spine_config": {
    "default_app": "answer-once",
    "default_role": "member_admin",
    "allow_url_override": true,
    "app_roles": [
      "member",
      "member_admin",
      "support",
      "support_admin"
    ],
    "route_prefix": "/",
    "account_strategy": "new",
    "parent_account": "spine-system",
    "allow_domain_join": false,
    "branding": {
      "app_name": "Answer Once",
      "title": "Answer Once",
      "logo_url": "/answer-once-logo.svg",
      "favicon_url": "/answer-once-icon.svg"
    },
    "brands": {
      "default": "answer-once",
      "by_host": {
        "support.answer-once.com": "answer-once",
        "support.spine-framework.com": "spine"
      },
      "definitions": {
        "answer-once": {
          "name": "Answer Once",
          "title": "Answer Once",
          "site_url": "https://support.answer-once.com",
          "logo_url": "/answer-once-logo.svg",
          "favicon_url": "/answer-once-icon.svg",
          "email_logo_url": "https://support.answer-once.com/answer-once-logo-wht.png",
          "email_from": "Answer Once Support <noreply@notifications.answer-once.com>"
        },
        "spine": {
          "name": "Spine",
          "title": "Spine Framework",
          "site_url": "https://support.spine-framework.com",
          "logo_url": "/spine-logo.svg",
          "favicon_url": "/spine-logo.svg",
          "email_logo_url": "https://support.spine-framework.com/spine-logo.jpg",
          "email_from": "Spine Framework Support <noreply@notifications.answer-once.com>"
        }
      }
    }
  },
  "package": {
    "name": "answer-once",
    "version": "0.2.0",
    "description": "Answer Once \u2014 standalone Spine Framework app (frozen framework snapshot)",
    "scripts": {
      "dev": "vite --config config/vite.config.ts",
      "dev:netlify": "bash scripts/dev-netlify.sh",
      "dev:stop": "bash scripts/dev-clean.sh",
      "predev:netlify": "npm run assemble",
      "assemble": "bash scripts/assemble.sh",
      "prebuild": "npm run verify && npm run assemble",
      "build": "vite build --config config/vite.config.ts",
      "verify": "bash scripts/verify-integrity.sh",
      "manifest": "bash scripts/build-manifest.sh",
      "verify:install": "tsx scripts/verify-install.ts",
      "typecheck": "tsc -b config/tsconfig.json",
      "typecheck:functions": "tsc --noEmit -p config/tsconfig.functions.json",
      "test": "vitest run",
      "spine-framework": "tsx .framework/cli/index.ts"
    }
  }
}
