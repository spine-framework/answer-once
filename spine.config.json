{
  "branding": {
    "app_name": "Answer Once",
    "title": "Answer Once",
    "logo_url": "/answer-once-logo.svg",
    "favicon_url": "/answer-once-icon.svg"
  },
  "registration": {
    "default_app": "answer-once",
    "default_role": "member_admin",
    "allow_url_override": true,
    "default_app_by_role": {
      "member": "answer-once",
      "member_admin": "answer-once",
      "support": "answer-once",
      "support_admin": "answer-once"
    },
    "apps": {
      "answer-once": {
        "roles": [
          "member",
          "member_admin",
          "support",
          "support_admin"
        ],
        "default_role": "member_admin",
        "path": "/answer-once",
        "enabled": true,
        "account_strategy": "new",
        "parent_account": "spine-system",
        "allow_domain_join": false
      }
    }
  }
}
